# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/partner_portal

# Auth — required in production (never use default JWT_SECRET in prod)
JWT_SECRET=change-me-to-a-long-random-string

# Operations Portal — used only by `npm run db:seed-admin` when admin_users is empty
ADMIN_EMAIL=admin@operations.local
ADMIN_PASSWORD=OperationsAdmin123!

# Partner portal / CORS — required in production
FRONTEND_URL=http://localhost:5173

# Optional: allow Operations API without Bearer token (development only; never in production)
# ALLOW_OPERATIONS_AUTH_BYPASS=true

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Email (Phase 2 — optional until SMTP is configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=noreply@example.com

# Partner portal public URL (used in email links)
PARTNER_PORTAL_PUBLIC_URL=http://localhost:5173

# Cloudinary — document upload, view, and download
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# In Cloudinary Console → Settings → Security: enable "Allow delivery of PDF and ZIP files"

# Observability (optional)
SENTRY_DSN=
